{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information and workspace metadata",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The Firebase Auth UID of the user"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["userId", "email"]
    },
    "FinancialAccount": {
      "title": "FinancialAccount",
      "description": "Financial account (Wallet, Savings, Credit, Loans)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique account identifier" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "name": { "type": "string", "description": "Account name", "maxLength": 100 },
        "providerId": { "type": "string", "description": "Preset provider identifier", "maxLength": 50 },
        "category": { "type": "string", "description": "Account category" },
        "startingBalance": { "type": "number", "description": "Starting balance in PHP" },
        "totalRepayment": { "type": "number", "description": "Total repayment for loans or credit" },
        "description": { "type": "string", "description": "Optional notes or account description", "maxLength": 500 },
        "customColor": { "type": "string", "description": "Custom hex color" },
        "accountNumberMasked": { "type": "string", "description": "Masked account number", "maxLength": 30 },
        "archived": { "type": "boolean", "description": "Whether account is archived" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last modified timestamp" },
        "isDeleted": { "type": "boolean", "description": "Tombstone flag for sync" }
      },
      "required": ["id", "userId", "name", "category"]
    },
    "TransactionRecord": {
      "title": "TransactionRecord",
      "description": "Financial transaction entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique transaction identifier" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "type": { "type": "string", "description": "Transaction type" },
        "amount": { "type": "number", "description": "Transaction amount in PHP" },
        "accountId": { "type": "string", "description": "Source account ID" },
        "destinationAccountId": { "type": "string", "description": "Destination account ID" },
        "category": { "type": "string", "description": "Transaction category" },
        "merchantOrTitle": { "type": "string", "description": "Title or payee", "maxLength": 200 },
        "dateTime": { "type": "string", "description": "Transaction date and time ISO" },
        "notes": { "type": "string", "description": "Optional notes", "maxLength": 500 },
        "adjustmentSign": { "type": "string", "description": "Positive or negative adjustment" },
        "interestPortion": { "type": "number", "description": "Interest portion of payment" },
        "isStartingBalance": { "type": "boolean", "description": "Starting balance marker" },
        "updatedAt": { "type": "string", "description": "Last modified timestamp" },
        "isDeleted": { "type": "boolean", "description": "Tombstone flag for sync" }
      },
      "required": ["id", "userId", "type", "amount", "accountId", "category", "dateTime"]
    },
    "BillDefinition": {
      "title": "BillDefinition",
      "description": "Recurring bill schedule definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique bill identifier" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "name": { "type": "string", "description": "Bill name", "maxLength": 100 },
        "category": { "type": "string", "description": "Bill category" },
        "customCategoryName": { "type": "string", "description": "Custom category name", "maxLength": 100 },
        "type": { "type": "string", "description": "Bill type" },
        "defaultAmount": { "type": "number", "description": "Default due amount" },
        "dueDay": { "type": "number", "description": "Due day of month 1-31" },
        "startMonth": { "type": "string", "description": "Start month YYYY-MM" },
        "endMonth": { "type": "string", "description": "End month YYYY-MM" },
        "frequency": { "type": "string", "description": "Bill recurrence" },
        "notes": { "type": "string", "description": "Notes", "maxLength": 500 },
        "reminderEnabled": { "type": "boolean", "description": "Reminder flag" },
        "reminderDaysBefore": { "type": "number", "description": "Days before due date" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last modified timestamp" },
        "isDeleted": { "type": "boolean", "description": "Tombstone flag for sync" }
      },
      "required": ["id", "userId", "name", "category", "defaultAmount", "dueDay"]
    },
    "MonthlyBillEntry": {
      "title": "MonthlyBillEntry",
      "description": "Month-specific bill instance and payment records",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Entry ID formatted as billId_monthKey" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "billId": { "type": "string", "description": "Parent bill ID" },
        "monthKey": { "type": "string", "description": "Month YYYY-MM" },
        "dueDay": { "type": "number", "description": "Due day override" },
        "dueDate": { "type": "string", "description": "Due date YYYY-MM-DD" },
        "estimatedAmount": { "type": "number", "description": "Estimated bill amount" },
        "actualAmount": { "type": "number", "description": "Actual billed amount" },
        "notes": { "type": "string", "description": "Monthly note", "maxLength": 500 },
        "isPaidManually": { "type": "boolean", "description": "Manual paid flag" },
        "updatedAt": { "type": "string", "description": "Last modified timestamp" },
        "isDeleted": { "type": "boolean", "description": "Tombstone flag for sync" }
      },
      "required": ["id", "userId", "billId", "monthKey", "actualAmount"]
    },
    "ReceivableRecord": {
      "title": "ReceivableRecord",
      "description": "Money Owed to Me receivable record and loan terms",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique receivable identifier" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "personName": { "type": "string", "description": "Borrower name", "maxLength": 100 },
        "principal": { "type": "number", "description": "Principal amount lent in PHP" },
        "termMonths": { "type": "number", "description": "Term in months" },
        "collectionDueDay": { "type": "number", "description": "Day of month for collection" },
        "scheduleStartDate": { "type": "string", "description": "Start date YYYY-MM-DD" },
        "lentDate": { "type": "string", "description": "Lent date YYYY-MM-DD" },
        "dueDate": { "type": "string", "description": "Final due date YYYY-MM-DD" },
        "totalExpected": { "type": "number", "description": "Total expected return" },
        "totalCollected": { "type": "number", "description": "Total amount collected" },
        "remainingBalance": { "type": "number", "description": "Remaining unpaid balance" },
        "contactInfo": { "type": "string", "description": "Contact info", "maxLength": 200 },
        "notes": { "type": "string", "description": "Notes", "maxLength": 500 },
        "updatedAt": { "type": "string", "description": "Last modified timestamp" },
        "isDeleted": { "type": "boolean", "description": "Tombstone flag for sync" }
      },
      "required": ["id", "userId", "personName", "principal", "totalExpected", "remainingBalance"]
    },
    "MonthlyBudget": {
      "title": "MonthlyBudget",
      "description": "Monthly spending budget and category caps",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Month key YYYY-MM" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "monthKey": { "type": "string", "description": "Month key YYYY-MM" },
        "totalBudget": { "type": "number", "description": "Total monthly budget in PHP" },
        "alertThresholdPercent": { "type": "number", "description": "Alert threshold percentage" },
        "updatedAt": { "type": "string", "description": "Last modified timestamp" },
        "isDeleted": { "type": "boolean", "description": "Tombstone flag for sync" }
      },
      "required": ["id", "userId", "monthKey", "totalBudget"]
    },
    "UserWorkspaceSync": {
      "title": "UserWorkspaceSync",
      "description": "Unified workspace snapshot and settings sync document",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user UID" },
        "version": { "type": "number", "description": "Data schema version" },
        "updatedAt": { "type": "string", "description": "Last modified timestamp" }
      },
      "required": ["userId", "version", "updatedAt"]
    },
    "GroceryItem": {
      "title": "GroceryItem",
      "description": "Grocery list item entry for planning and purchase tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique grocery item identifier" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "name": { "type": "string", "description": "Grocery item name", "maxLength": 100 },
        "category": { "type": "string", "description": "Category name", "maxLength": 50 },
        "quantity": { "type": "number", "description": "Quantity number" },
        "unit": { "type": "string", "description": "Unit of measurement", "maxLength": 30 },
        "estimatedPrice": { "type": "number", "description": "Estimated unit price in PHP" },
        "estimatedTotal": { "type": "number", "description": "Estimated item total in PHP" },
        "isPurchased": { "type": "boolean", "description": "Whether item is purchased" },
        "purchasedDate": { "type": "string", "description": "Date of purchase YYYY-MM-DD" },
        "notes": { "type": "string", "description": "Optional notes", "maxLength": 500 },
        "isRecordedAsExpense": { "type": "boolean", "description": "Expense recorded flag" },
        "expenseTransactionId": { "type": "string", "description": "Associated expense transaction ID" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last modified timestamp" },
        "isDeleted": { "type": "boolean", "description": "Tombstone flag for sync" }
      },
      "required": ["id", "userId", "name", "category", "quantity", "estimatedPrice", "estimatedTotal"]
    },
    "GroceryCategory": {
      "title": "GroceryCategory",
      "description": "Built-in or custom grocery category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique category identifier" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "name": { "type": "string", "description": "Category name", "maxLength": 50 },
        "icon": { "type": "string", "description": "Category emoji or icon identifier", "maxLength": 20 },
        "description": { "type": "string", "description": "Category description", "maxLength": 200 },
        "isCustom": { "type": "boolean", "description": "Custom category flag" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "name"]
    },
    "JointWorkspace": {
      "title": "JointWorkspace",
      "description": "Collaborative shared household or partner workspace",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique joint workspace identifier" },
        "name": { "type": "string", "description": "Joint workspace display name", "maxLength": 100 },
        "relationship": { "type": "string", "description": "Relationship type: Partner (2), Spouse (2), Family (10), Housemate (10), Other (10)", "maxLength": 50 },
        "memberLimit": { "type": "number", "description": "Maximum members allowed in this workspace (2 for partner/spouse, 10 for family/housemate/other)" },
        "ownerUid": { "type": "string", "description": "Creator user UID" },
        "ownerEmail": { "type": "string", "description": "Creator email" },
        "clearedAtByMember": { "type": "object", "description": "Map of user UID to ISO timestamp when chat was cleared for them" },
        "chatClearedForEveryoneAt": { "type": "string", "description": "ISO timestamp when chat was cleared for all members" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last modified timestamp" }
      },
      "required": ["id", "name", "ownerUid", "ownerEmail"]
    },
    "JointInvitation": {
      "title": "JointInvitation",
      "description": "Joint workspace partner invitation document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique invitation identifier" },
        "jointWorkspaceId": { "type": "string", "description": "Target joint workspace ID" },
        "jointWorkspaceName": { "type": "string", "description": "Workspace name", "maxLength": 100 },
        "inviterUid": { "type": "string", "description": "Inviter user UID" },
        "inviterEmail": { "type": "string", "description": "Inviter email" },
        "inviterName": { "type": "string", "description": "Inviter name", "maxLength": 100 },
        "inviteeEmail": { "type": "string", "description": "Target invitee email address" },
        "relationship": { "type": "string", "description": "Relationship label", "maxLength": 50 },
        "message": { "type": "string", "description": "Optional invitation note", "maxLength": 500 },
        "status": { "type": "string", "description": "Status: pending, accepted, declined, revoked" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "respondedAt": { "type": "string", "description": "Response timestamp" }
      },
      "required": ["id", "jointWorkspaceId", "inviterUid", "inviterEmail", "inviteeEmail", "status"]
    },
    "JointActivityItem": {
      "title": "JointActivityItem",
      "description": "Activity audit log record in a joint workspace",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique activity identifier" },
        "jointWorkspaceId": { "type": "string", "description": "Target workspace ID" },
        "actorUid": { "type": "string", "description": "Actor user UID" },
        "actorName": { "type": "string", "description": "Actor display name", "maxLength": 100 },
        "actionType": { "type": "string", "description": "Type of financial or member action" },
        "description": { "type": "string", "description": "Human-readable activity summary", "maxLength": 500 },
        "amount": { "type": "number", "description": "Optional associated PHP amount" },
        "timestamp": { "type": "string", "description": "Activity timestamp" }
      },
      "required": ["id", "jointWorkspaceId", "actorUid", "actorName", "actionType", "description", "timestamp"]
    },
    "JointMessage": {
      "title": "JointMessage",
      "description": "Secure encrypted or plain chat message exchanged between joint workspace partners",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Client-generated unique message identifier" },
        "workspaceId": { "type": "string", "description": "Target joint workspace identifier" },
        "senderUid": { "type": "string", "description": "Sender user UID" },
        "senderName": { "type": "string", "description": "Sender display name", "maxLength": 100 },
        "senderEmail": { "type": "string", "description": "Sender email address" },
        "recipientUid": { "type": "string", "description": "Recipient partner user UID" },
        "text": { "type": "string", "description": "Message content", "maxLength": 2000 },
        "timestamp": { "type": "string", "description": "Message creation ISO timestamp" },
        "status": { "type": "string", "description": "Delivery status: pending, sent, delivered, read, failed" },
        "readAt": { "type": "string", "description": "Read receipt timestamp" },
        "deliveredAt": { "type": "string", "description": "Delivered receipt timestamp" },
        "deletedForUserIds": { "type": "array", "description": "List of user UIDs who deleted message for themselves" },
        "isUnsent": { "type": "boolean", "description": "Whether message has been unsent for everyone" },
        "unsentAt": { "type": "string", "description": "Timestamp when message was unsent" },
        "unsentByUid": { "type": "string", "description": "UID of sender who unsent message" }
      },
      "required": ["id", "workspaceId", "senderUid", "recipientUid", "timestamp", "status"]
    },
    "JointRingRequest": {
      "title": "JointRingRequest",
      "description": "Real-time ring partner alert event and connection request",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique ring request identifier" },
        "workspaceId": { "type": "string", "description": "Target joint workspace identifier" },
        "callerUid": { "type": "string", "description": "Caller user UID" },
        "callerName": { "type": "string", "description": "Caller display name", "maxLength": 100 },
        "targetUid": { "type": "string", "description": "Target partner user UID" },
        "status": { "type": "string", "description": "Ring status: ringing, accepted, dismissed, cancelled, expired" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "expiresAt": { "type": "string", "description": "Expiration timestamp" },
        "respondedAt": { "type": "string", "description": "Response timestamp" }
      },
      "required": ["id", "workspaceId", "callerUid", "targetUid", "status", "createdAt", "expiresAt"]
    },
    "UserDeviceToken": {
      "title": "UserDeviceToken",
      "description": "Registered push notification and device token for mobile and web push",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique device token identifier" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "token": { "type": "string", "description": "FCM or web push device token", "maxLength": 500 },
        "platform": { "type": "string", "description": "Platform: web, android, ios" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["id", "userId", "token", "platform", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile information"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": "FinancialAccount",
      "description": "User financial accounts"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "TransactionRecord",
      "description": "User transactions"
    },
    "/users/{userId}/bills/{billId}": {
      "schema": "BillDefinition",
      "description": "User recurring bill definitions"
    },
    "/users/{userId}/monthlyBillEntries/{entryId}": {
      "schema": "MonthlyBillEntry",
      "description": "User monthly bill entries"
    },
    "/users/{userId}/receivables/{receivableId}": {
      "schema": "ReceivableRecord",
      "description": "User receivables (Money Owed to Me)"
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": "MonthlyBudget",
      "description": "User monthly budgets"
    },
    "/users/{userId}/groceries/{groceryId}": {
      "schema": "GroceryItem",
      "description": "User grocery items"
    },
    "/users/{userId}/groceryCategories/{categoryId}": {
      "schema": "GroceryCategory",
      "description": "User custom grocery categories"
    },
    "/users/{userId}/sync/state": {
      "schema": "UserWorkspaceSync",
      "description": "User workspace sync snapshot"
    },
    "/jointWorkspaces/{workspaceId}": {
      "schema": "JointWorkspace",
      "description": "Collaborative joint workspace metadata"
    },
    "/jointWorkspaces/{workspaceId}/accounts/{accountId}": {
      "schema": "FinancialAccount",
      "description": "Joint shared financial accounts"
    },
    "/jointWorkspaces/{workspaceId}/transactions/{transactionId}": {
      "schema": "TransactionRecord",
      "description": "Joint shared transactions"
    },
    "/jointWorkspaces/{workspaceId}/bills/{billId}": {
      "schema": "BillDefinition",
      "description": "Joint shared bills"
    },
    "/jointWorkspaces/{workspaceId}/monthlyBillEntries/{entryId}": {
      "schema": "MonthlyBillEntry",
      "description": "Joint monthly bill instances"
    },
    "/jointWorkspaces/{workspaceId}/budgets/{budgetId}": {
      "schema": "MonthlyBudget",
      "description": "Joint shared budgets"
    },
    "/jointWorkspaces/{workspaceId}/groceries/{groceryId}": {
      "schema": "GroceryItem",
      "description": "Joint shared grocery items"
    },
    "/jointWorkspaces/{workspaceId}/activity/{activityId}": {
      "schema": "JointActivityItem",
      "description": "Joint shared activity timeline records"
    },
    "/jointInvitations/{invitationId}": {
      "schema": "JointInvitation",
      "description": "Joint invitations between users"
    },
    "/jointWorkspaces/{workspaceId}/messages/{messageId}": {
      "schema": "JointMessage",
      "description": "Chat messages exchanged between joint workspace partners"
    },
    "/jointWorkspaces/{workspaceId}/ringRequests/{ringId}": {
      "schema": "JointRingRequest",
      "description": "Ring partner alert signals and call requests"
    },
    "/users/{userId}/deviceTokens/{tokenId}": {
      "schema": "UserDeviceToken",
      "description": "Registered push notification and device tokens"
    }
  }
}
