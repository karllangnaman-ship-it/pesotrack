# ---------------------------------------------------------------------------
# PESOTRACK OFFLINE & VERCEL ONLINE-ONLY BACKEND CONFIGURATION
# ---------------------------------------------------------------------------

# Public Client Configuration (Vite & Capacitor Android)
# Production Vercel deployment URL (e.g., https://pesotrack.vercel.app).
# When running on web on the same Vercel origin, leave blank to use relative /api.
# In Android Capacitor release APK, set this to your deployed Vercel domain.
VITE_API_BASE_URL=""

# APP_URL: The URL where this web application is hosted.
APP_URL=""

# Allowed Origins for Server CORS (comma-separated list, e.g., https://pesotrack.vercel.app,capacitor://localhost)
ALLOWED_ORIGINS=""

# ---------------------------------------------------------------------------
# Vercel Server-Only Environment Variables (Private - Do NOT prefix with VITE_)
# Set these in: Vercel Project Settings -> Environment Variables
# ---------------------------------------------------------------------------

# Firebase Admin SDK Credentials (Method 1: Individual fields)
FIREBASE_PROJECT_ID="pesotrack-51670"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Firebase Admin SDK Credentials (Method 2: Full Service Account JSON string)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"pesotrack-51670",...}'

# AI Studio server-side API Key
GEMINI_API_KEY=""
